{
  "Fast IO": {
    "prefix": "fastio",
    "body": [
      "use std::io::{self, BufWriter, Read, StdoutLock, Write};",
      "",
      "pub struct FastReader {",
      "    bytes: Vec<u8>,",
      "    ptr: usize,",
      "}",
      "",
      "impl FastReader {",
      "    #[allow(clippy::new_without_default)]",
      "    pub fn new() -> Self {",
      "        let mut bytes = Vec::new();",
      "        io::stdin().read_to_end(&mut bytes).unwrap();",
      "",
      "        Self { bytes, ptr: 0 }",
      "    }",
      "",
      "    pub fn next_usize(&mut self) -> usize {",
      "        let bytes = self.next_token();",
      "        FastReader::parse_digits(bytes)",
      "    }",
      "",
      "    pub fn next_isize(&mut self) -> isize {",
      "        let mut bytes = self.next_token();",
      "        let neg = {",
      "            if bytes[0] == b'-' {",
      "                bytes = &bytes[1..];",
      "                true",
      "            } else {",
      "                false",
      "            }",
      "        };",
      "",
      "        let result = FastReader::parse_digits(bytes);",
      "",
      "        if neg {",
      "            (result as isize).wrapping_neg()",
      "        } else {",
      "            result as isize",
      "        }",
      "    }",
      "",
      "    fn parse_digits(bytes: &[u8]) -> usize {",
      "        let mut result = 0;",
      "",
      "        for x in bytes {",
      "            if !x.is_ascii_digit() {",
      "                panic!(\"unexpected non-digit char: {}\", x);",
      "            }",
      "",
      "            result = result * 10 + (x - b'0') as usize;",
      "        }",
      "",
      "        result",
      "    }",
      "",
      "    pub fn skip_tokens(&mut self, n: usize) {",
      "        for _ in 0..n {",
      "            self.next_token();",
      "        }",
      "    }",
      "",
      "    fn next_token(&mut self) -> &[u8] {",
      "        self.skip_whitespaces();",
      "",
      "        let start = self.ptr;",
      "",
      "        while self.ptr < self.bytes.len() && !self.bytes[self.ptr].is_ascii_whitespace() {",
      "            self.ptr += 1",
      "        }",
      "",
      "        if start == self.ptr {",
      "            panic!(\"unexpected EOF when parsing next token\");",
      "        }",
      "",
      "        &self.bytes[start..self.ptr]",
      "    }",
      "",
      "    fn next_line(&mut self) -> Option<&[u8]> {",
      "        if self.ptr < self.bytes.len() && self.bytes[self.ptr] == b'\\r' {",
      "            self.ptr += 1;",
      "        }",
      "",
      "        if self.ptr < self.bytes.len() && self.bytes[self.ptr] == b'\\n' {",
      "            self.ptr += 1;",
      "        }",
      "",
      "        if self.ptr >= self.bytes.len() {",
      "            return None;",
      "        }",
      "",
      "        let start = self.ptr;",
      "",
      "        while self.ptr < self.bytes.len()",
      "            && self.bytes[self.ptr] != b'\\r'",
      "            && self.bytes[self.ptr] != b'\\n'",
      "        {",
      "            self.ptr += 1;",
      "        }",
      "",
      "        Some(&self.bytes[start..self.ptr])",
      "    }",
      "",
      "    fn skip_whitespaces(&mut self) {",
      "        while self.ptr < self.bytes.len() && self.bytes[self.ptr].is_ascii_whitespace() {",
      "            self.ptr += 1",
      "        }",
      "    }",
      "}",
      "",
      "pub struct FastWriter {",
      "    writer: BufWriter<StdoutLock<'static>>,",
      "}",
      "",
      "impl FastWriter {",
      "    #[allow(clippy::new_without_default)]",
      "    pub fn new() -> Self {",
      "        let writer = BufWriter::new(io::stdout().lock());",
      "        Self { writer }",
      "    }",
      "}",
      "",
      "impl Write for FastWriter {",
      "    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {",
      "        self.writer.write(buf)",
      "    }",
      "",
      "    fn flush(&mut self) -> io::Result<()> {",
      "        self.writer.flush()",
      "    }",
      "}",
      "",
      "#[allow(unused)]",
      "macro_rules! write {",
      "    (\\$dst:expr, \\$(\\$arg:tt)*) => {",
      "        let _ = Write::write_fmt(&mut \\$dst, format_args!(\\$(\\$arg)*));",
      "    };",
      "}",
      "",
      "#[allow(unused)]",
      "macro_rules! writeln {",
      "    (\\$dst:expr \\$(,)?) => {",
      "        let _ = Write::write_all(&mut \\$dst, b\"\\n\");",
      "    };",
      "",
      "    (\\$dst:expr, \\$(\\$arg:tt)*) => {",
      "        let _ = Write::write_fmt(&mut \\$dst, format_args!(\\$(\\$arg)*));",
      "        let _ = Write::write_all(&mut \\$dst, b\"\\n\");",
      "    };",
      "}",
      "",
      "fn main() {",
      "    let mut r = FastReader::new();",
      "    let mut w = FastWriter::new();",
      "    $0",
      "}"
    ],
    "description": "Fast IO"
  }
}
