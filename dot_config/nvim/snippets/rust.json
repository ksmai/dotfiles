{
  "Fast IO": {
    "prefix": "fastio",
    "body": [
      "#![allow(clippy::needless_range_loop)]",
      "",
      "fn main() {",
      "    $0",
      "}",
      "",
      "mod fastio {",
      "    use std::{",
      "        cell::UnsafeCell,",
      "        ffi,",
      "        io::{self, BufWriter, StdoutLock, Write},",
      "        sync::OnceLock,",
      "    };",
      "",
      "    struct NotThreadSafe<T>(UnsafeCell<T>);",
      "    unsafe impl<T> Sync for NotThreadSafe<T> {}",
      "    unsafe impl<T> Send for NotThreadSafe<T> {}",
      "",
      "    impl<T> NotThreadSafe<T> {",
      "        const fn new(value: T) -> Self {",
      "            Self(UnsafeCell::new(value))",
      "        }",
      "    }",
      "",
      "    pub struct Scanner {",
      "        buf: Box<[u8]>,",
      "        pos: usize,",
      "        amt: usize,",
      "    }",
      "",
      "    unsafe extern \"C\" {",
      "        fn read(fd: i32, buf: *mut ffi::c_void, count: usize) -> isize;",
      "    }",
      "",
      "    impl Scanner {",
      "        fn peek(&mut self) -> Option<u8> {",
      "            if self.pos == self.amt {",
      "                let ret =",
      "                    unsafe { read(0, self.buf.as_mut_ptr() as *mut ffi::c_void, self.buf.len()) };",
      "",
      "                if ret < 0 {",
      "                    panic!();",
      "                }",
      "",
      "                self.amt = ret as usize;",
      "                self.pos = 0;",
      "            }",
      "",
      "            if self.amt > 0 {",
      "                Some(unsafe { *self.buf.get_unchecked(self.pos) })",
      "            } else {",
      "                None",
      "            }",
      "        }",
      "",
      "        fn consume(&mut self, amt: usize) {",
      "            self.pos += amt;",
      "        }",
      "",
      "        #[allow(unused)]",
      "        fn scan_line(&mut self) -> Vec<u8> {",
      "            let mut result = Vec::new();",
      "",
      "            loop {",
      "                match self.peek() {",
      "                    Some(b) if b.is_ascii_whitespace() => self.consume(1),",
      "                    Some(b) => {",
      "                        self.consume(1);",
      "                        result.push(b);",
      "                        break;",
      "                    }",
      "                    None => panic!(\"Expected a byte/char when scanning line. Got: EOF\"),",
      "                }",
      "            }",
      "",
      "            loop {",
      "                match self.peek() {",
      "                    Some(b) if b != b'\\r' && b != b'\\n' => {",
      "                        self.consume(1);",
      "                        result.push(b)",
      "                    }",
      "                    _ => break,",
      "                }",
      "            }",
      "",
      "            result",
      "        }",
      "    }",
      "",
      "    pub trait Scan<T> {",
      "        fn scan(&mut self) -> T;",
      "    }",
      "",
      "    macro_rules! impl_scan_integer {",
      "        (\\$t:ty, \\$signed:ident) => {",
      "            impl Scan<\\$t> for Scanner {",
      "                #[allow(unused)]",
      "                fn scan(&mut self) -> \\$t {",
      "                    let mut neg = false;",
      "                    let mut value;",
      "",
      "                    loop {",
      "                        match self.peek() {",
      "                            Some(b) if b.is_ascii_whitespace() => self.consume(1),",
      "",
      "                            Some(b) if b == b'+' || stringify!(\\$signed) == \"signed\" && b == b'-' => {",
      "                                self.consume(1);",
      "",
      "                                if b == b'-' {",
      "                                    neg = true;",
      "                                }",
      "",
      "                                match self.peek() {",
      "                                    Some(b) if b.is_ascii_digit() => {",
      "                                        self.consume(1);",
      "                                        value = (b - b'0') as \\$t;",
      "                                    }",
      "                                    Some(b2) => panic!(\"Expected a digit to follow \\\"{}\\\" when scanning {}. Got: {}\", b as char, stringify!(\\$t), b2 as char),",
      "                                    None => panic!(\"Expected a digit to follow \\\"{}\\\" when scanning {}. Got: EOF\", b as char, stringify!(\\$t)),",
      "                                }",
      "",
      "                                break;",
      "                            }",
      "",
      "                            Some(b) if b.is_ascii_digit() => {",
      "                                self.consume(1);",
      "                                value = (b - b'0') as \\$t;",
      "                                break;",
      "                            }",
      "",
      "                            Some(b) => panic!(\"Expected a digit or a sign when scanning {}. Got: {}\", stringify!(\\$t), b as char),",
      "                            None => panic!(\"Expected a digit or a sign when scanning {}. Got: EOF\", stringify!(\\$t)),",
      "                        }",
      "                    }",
      "",
      "                    loop {",
      "                        match self.peek() {",
      "                            Some(b) if b.is_ascii_digit() => {",
      "                                self.consume(1);",
      "                                value = 10 * value + (b - b'0') as \\$t;",
      "                            }",
      "                            _ => break,",
      "                        }",
      "                    }",
      "",
      "                    impl_scan_integer!(@finalize \\$signed, neg, value)",
      "                }",
      "            }",
      "        };",
      "",
      "        (@finalize signed, \\$neg:ident, \\$value:ident) => { if \\$neg { -\\$value } else { \\$value } };",
      "        (@finalize unsigned, \\$neg:ident, \\$value:ident) => { \\$value };",
      "    }",
      "",
      "    impl_scan_integer!(i8, signed);",
      "    impl_scan_integer!(i16, signed);",
      "    impl_scan_integer!(i32, signed);",
      "    impl_scan_integer!(i64, signed);",
      "    impl_scan_integer!(isize, signed);",
      "",
      "    impl_scan_integer!(u16, unsigned);",
      "    impl_scan_integer!(u32, unsigned);",
      "    impl_scan_integer!(u64, unsigned);",
      "    impl_scan_integer!(usize, unsigned);",
      "",
      "    macro_rules! impl_scan_float {",
      "        (\\$t:ty) => {",
      "            impl Scan<\\$t> for Scanner {",
      "                fn scan(&mut self) -> \\$t {",
      "                    loop {",
      "                        match self.peek() {",
      "                            Some(b) if b.is_ascii_whitespace() => self.consume(1),",
      "                            Some(_) => break,",
      "                            None => {",
      "                                panic!(\"Expected float when scanning {}. Got: EOF\", stringify!(\\$t))",
      "                            }",
      "                        }",
      "                    }",
      "",
      "                    let mut bytes = [0u8; 64];",
      "                    let mut len = 0;",
      "",
      "                    loop {",
      "                        match self.peek() {",
      "                            Some(b) if !b.is_ascii_whitespace() => {",
      "                                self.consume(1);",
      "                                if len < bytes.len() {",
      "                                    bytes[len] = b;",
      "                                    len += 1;",
      "                                } else {",
      "                                    panic!(\"Float token too long when scanning {}\", stringify!(\\$t));",
      "                                }",
      "                            }",
      "                            _ => break,",
      "                        }",
      "                    }",
      "",
      "                    let Ok(s) = std::str::from_utf8(&bytes[..len]) else {",
      "                        panic!(\"Invalid UTF-8 sequence while scanning {}\", stringify!(\\$t));",
      "                    };",
      "",
      "                    let Ok(f) = s.parse::<\\$t>() else {",
      "                        panic!(\"Failed to parse \\\"{}\\\" as {}\", s, stringify!(\\$t));",
      "                    };",
      "",
      "                    f",
      "                }",
      "            }",
      "        };",
      "    }",
      "",
      "    impl_scan_float!(f32);",
      "    impl_scan_float!(f64);",
      "",
      "    impl Scan<u8> for Scanner {",
      "        fn scan(&mut self) -> u8 {",
      "            loop {",
      "                match self.peek() {",
      "                    Some(b) if b.is_ascii_whitespace() => self.consume(1),",
      "                    Some(b) => {",
      "                        self.consume(1);",
      "                        return b;",
      "                    }",
      "                    None => panic!(\"Expected a byte/char when scanning u8. Got: EOF\"),",
      "                }",
      "            }",
      "        }",
      "    }",
      "",
      "    impl Scan<Vec<u8>> for Scanner {",
      "        fn scan(&mut self) -> Vec<u8> {",
      "            let mut result = Vec::new();",
      "",
      "            loop {",
      "                match self.peek() {",
      "                    Some(b) if b.is_ascii_whitespace() => self.consume(1),",
      "                    Some(b) => {",
      "                        self.consume(1);",
      "                        result.push(b);",
      "                        break;",
      "                    }",
      "                    None => panic!(\"Expected a char when scanning Vec<u8>. Got: EOF\"),",
      "                }",
      "            }",
      "",
      "            loop {",
      "                match self.peek() {",
      "                    Some(b) if !b.is_ascii_whitespace() => {",
      "                        self.consume(1);",
      "                        result.push(b);",
      "                    }",
      "                    _ => break,",
      "                }",
      "            }",
      "",
      "            result",
      "        }",
      "    }",
      "",
      "    static SCANNER: OnceLock<NotThreadSafe<Scanner>> = OnceLock::new();",
      "",
      "    fn get_scanner() -> &'static mut Scanner {",
      "        let wrapper = SCANNER.get_or_init(|| {",
      "            NotThreadSafe::new(Scanner {",
      "                buf: vec![0; 64 * 1024].into_boxed_slice(),",
      "                pos: 0,",
      "                amt: 0,",
      "            })",
      "        });",
      "        unsafe { &mut *wrapper.0.get() }",
      "    }",
      "",
      "    pub fn scan<T>() -> T",
      "    where",
      "        Scanner: Scan<T>,",
      "    {",
      "        Scan::<T>::scan(get_scanner())",
      "    }",
      "",
      "    #[macro_export]",
      "    #[allow(unused)]",
      "    macro_rules! scan {",
      "        (\\$t:ty) => { \\$crate::fastio::scan::<\\$t>() };",
      "        (\\$(\\$t:ty),+) => { (\\$(\\$crate::fastio::scan::<\\$t>(),)*) };",
      "",
      "        (\\$t:ty; \\$n:expr) => {{",
      "            let n = \\$n as usize;",
      "            let mut result = Vec::with_capacity(n);",
      "            let ptr: *mut \\$t = result.as_mut_ptr();",
      "",
      "            for i in 0..n {",
      "                unsafe { ptr.add(i).write(\\$crate::fastio::scan::<\\$t>()); }",
      "            }",
      "",
      "            unsafe { result.set_len(n); }",
      "",
      "            result",
      "        }};",
      "",
      "        (\\$t:ty; \\$n:expr; \\$m:expr) => {{",
      "            let n = \\$n as usize;",
      "            let mut result = Vec::with_capacity(n);",
      "",
      "            for _ in 0..n {",
      "                result.push(scan!(\\$t; \\$m));",
      "            }",
      "",
      "            result",
      "        }};",
      "    }",
      "",
      "    #[allow(unused)]",
      "    pub fn scan_line() -> Vec<u8> {",
      "        get_scanner().scan_line()",
      "    }",
      "",
      "    #[macro_export]",
      "    #[allow(unused)]",
      "    macro_rules! scan_line {",
      "        () => {",
      "            \\$crate::fastio::scan_line()",
      "        };",
      "",
      "        (\\$n:expr) => {{",
      "            let n = \\$n as usize;",
      "            let mut result = Vec::<Vec<u8>>::with_capacity(n);",
      "            let ptr: *mut Vec<u8> = result.as_mut_ptr();",
      "",
      "            for i in 0..n {",
      "                unsafe {",
      "                    ptr.add(i).write(scan_line!());",
      "                }",
      "            }",
      "",
      "            unsafe {",
      "                result.set_len(n);",
      "            }",
      "",
      "            result",
      "        }};",
      "    }",
      "",
      "    unsafe extern \"C\" {",
      "        fn atexit(cb: extern \"C\" fn()) -> i32;",
      "    }",
      "",
      "    static WRITER: OnceLock<NotThreadSafe<BufWriter<StdoutLock<'static>>>> = OnceLock::new();",
      "",
      "    pub fn get_writer() -> &'static mut BufWriter<StdoutLock<'static>> {",
      "        let wrapper = WRITER.get_or_init(|| {",
      "            unsafe {",
      "                atexit(flush_stdout_at_exit);",
      "            }",
      "",
      "            NotThreadSafe::new(BufWriter::new(io::stdout().lock()))",
      "        });",
      "        unsafe { &mut *wrapper.0.get() }",
      "    }",
      "",
      "    extern \"C\" fn flush_stdout_at_exit() {",
      "        flush();",
      "    }",
      "",
      "    pub fn flush() {",
      "        let _ = get_writer().flush();",
      "    }",
      "",
      "    #[macro_export]",
      "    #[allow(unused)]",
      "    macro_rules! print {",
      "        (\\$(\\$arg:tt)*) => {{",
      "            use std::io::Write;",
      "            let _ = write!(\\$crate::fastio::get_writer(), \\$(\\$arg)*);",
      "        }}",
      "    }",
      "",
      "    #[macro_export]",
      "    #[allow(unused)]",
      "    macro_rules! println {",
      "        (\\$(\\$arg:tt)*) => {{",
      "            use std::io::Write;",
      "            let _ = writeln!(\\$crate::fastio::get_writer(), \\$(\\$arg)*);",
      "        }}",
      "    }",
      "",
      "    #[macro_export]",
      "    #[allow(unused)]",
      "    macro_rules! flush {",
      "        () => {",
      "            \\$crate::fastio::flush()",
      "        };",
      "    }",
      "",
      "    pub struct AsStr<'a>(pub &'a [u8]);",
      "",
      "    impl<'a> std::fmt::Display for AsStr<'a> {",
      "        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {",
      "            let s = std::string::String::from_utf8_lossy(self.0);",
      "            write!(f, \"{}\", s)",
      "        }",
      "    }",
      "}",
      "",
      "pub use fastio::AsStr;"
    ],
    "description": "Fast IO"
  }
}
